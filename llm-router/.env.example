# Copy to .env (or export in your shell / systemd EnvironmentFile).
# API keys are read from the environment when a backend names one via
# `api_key_env` (PRD §9); a literal `api_key:` in the YAML also works and
# takes precedence — handy for local llama-servers started with --api-key.

# OpenRouter key for the frontier tier. Name must match `api_key_env` in config.yaml.
OPENROUTER_API_KEY=sk-or-...
